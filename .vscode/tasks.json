{
  "version": "2.0.0",
  "tasks": [
    // =========================================================================
    // Microservice 1: React 18 / Vite 5 Frontend Workstation
    // =========================================================================
    {
      "label": "Frontend: npm run dev",
      "type": "shell",
      "command": "npm run dev",
      "options": {
        "cwd": "${workspaceFolder}/frontend"
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "custom",
        "pattern": {
          "regexp": "^.*$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*vite.*",
          "endsPattern": ".*Local:.*http.*"
        }
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "dedicated",
        "group": "enterprise-platform"
      }
    },

    // =========================================================================
    // Microservice 2: ASP.NET Core 8 Web API Gateway
    // =========================================================================
    {
      "label": "Backend: dotnet run",
      "type": "shell",
      "command": "dotnet run",
      "options": {
        "cwd": "${workspaceFolder}/backend-api"
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "custom",
        "pattern": {
          "regexp": "^.*$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*Building.*|.*Restored.*",
          "endsPattern": ".*Now listening on:.*|.*Application started.*"
        }
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "dedicated",
        "group": "enterprise-platform"
      }
    },

    // =========================================================================
    // Microservice 3: Python / FastAPI AI Inference & Hybrid Retrieval Engine
    // =========================================================================
    {
      "label": "AI Service: uvicorn main:app --reload",
      "type": "shell",
      "command": "powershell -Command \"& '${workspaceFolder}/.venv/Scripts/python.exe' -m uvicorn main:app --host 0.0.0.0 --port 8000 --reload\"",
      "options": {
        "cwd": "${workspaceFolder}/ai-service",
        "env": {
          "PYTHONPATH": "${workspaceFolder}/ai-service"
        }
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "custom",
        "pattern": {
          "regexp": "^.*$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*Started server process.*|.*Waiting for application startup.*",
          "endsPattern": ".*Uvicorn running on.*|.*Application startup complete.*"
        }
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "dedicated",
        "group": "enterprise-platform"
      }
    },

    // =========================================================================
    // Compound Task: 🚀 Run Enterprise RAG Platform (Simultaneous Parallel Run)
    // =========================================================================
    {
      "label": "🚀 Run Enterprise RAG Platform",
      "dependsOn": [
        "Frontend: npm run dev",
        "Backend: dotnet run",
        "AI Service: uvicorn main:app --reload"
      ],
      "dependsOrder": "parallel",
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    }
  ]
}
