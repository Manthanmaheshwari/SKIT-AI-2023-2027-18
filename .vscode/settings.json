{
  // ==========================================
  // Global Editor & Format-on-Save Automation
  // ==========================================
  "editor.formatOnSave": true,
  "editor.codeActionsOnSave": {
    "source.organizeImports": "explicit",
    "source.fixAll.eslint": "explicit"
  },
  "editor.bracketPairColorization.enabled": true,
  "editor.guides.bracketPairs": "active",
  "editor.tabSize": 2,
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,

  // ==========================================
  // Terminal Defaults (PowerShell / Bash)
  // ==========================================
  "terminal.integrated.defaultProfile.windows": "PowerShell",
  "terminal.integrated.defaultProfile.linux": "bash",
  "terminal.integrated.defaultProfile.osx": "bash",
  "terminal.integrated.env.windows": {
    "PYTHONPATH": "${workspaceFolder}/ai-service"
  },

  // ==========================================
  // Python & AI Service Configuration
  // ==========================================
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/Scripts/python.exe",
  "python.analysis.extraPaths": [
    "${workspaceFolder}/ai-service"
  ],
  "python.analysis.autoImportCompletions": true,
  "python.analysis.typeCheckingMode": "basic",
  "[python]": {
    "editor.tabSize": 4,
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "ms-python.python",
    "editor.codeActionsOnSave": {
      "source.organizeImports": "explicit"
    }
  },

  // ==========================================
  // .NET & C# Configuration
  // ==========================================
  "dotnet.defaultSolution": "${workspaceFolder}/backend-api/EnterpriseApi.csproj",
  "[csharp]": {
    "editor.tabSize": 4,
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "ms-dotnettools.csharp"
  },

  // ==========================================
  // Frontend (React 18 / Tailwind CSS / Prettier)
  // ==========================================
  "[javascript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.tabSize": 2
  },
  "[javascriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.tabSize": 2
  },
  "[json]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.tabSize": 2
  },
  "[jsonc]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.tabSize": 2
  },
  "[css]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.tabSize": 2
  },
  "[markdown]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.wordWrap": "on"
  },
  "tailwindCSS.includeLanguages": {
    "javascript": "javascript",
    "javascriptreact": "javascriptreact"
  },
  "tailwindCSS.experimental.classRegex": [
    ["cva\\(([^)]*)\\)", "[\"'`]([^\"'`]*).*?[\"'`]"],
    ["cx\\(([^)]*)\\)", "(?:'|\"|`)([^']*)(?:'|\"|`)"]
  ],

  // ==========================================
  // Database Visualizer (SQLTools Pre-Configured)
  // ==========================================
  "sqltools.connections": [
    {
      "name": "EnterpriseAiPlatformDb (LocalDB)",
      "dialect": "MSSQL",
      "server": "(localdb)\\mssqllocaldb",
      "database": "EnterpriseAiPlatformDb",
      "connectString": "Server=(localdb)\\mssqllocaldb;Database=EnterpriseAiPlatformDb;Trusted_Connection=True;MultipleActiveResultSets=true;TrustServerCertificate=True",
      "askForPassword": false,
      "connectionTimeout": 30
    }
  ],

  // ==========================================
  // File Watcher & Search Optimizations
  // ==========================================
  "files.watcherExclude": {
    "**/.git/objects/**": true,
    "**/.git/subtree-cache/**": true,
    "**/node_modules/**": true,
    "**/.venv/**": true,
    "**/backend-api/bin/**": true,
    "**/backend-api/obj/**": true,
    "**/frontend/dist/**": true,
    "**/ai-service/__pycache__/**": true
  },
  "search.exclude": {
    "**/node_modules": true,
    "**/dist": true,
    "**/.venv": true,
    "**/bin": true,
    "**/obj": true,
    "**/__pycache__": true
  }
}
